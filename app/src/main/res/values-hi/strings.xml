    <!-- FAQ -->
    <string name="faq_general">सामान्य प्रश्न</string>
    <string name="faq_q1">Speye क्या है?</string>
    <string name="faq_a1">Speye आपकी सूचनाओं का ट्रैक रखने और उन्हें कभी न खोने के लिए एक निःशुल्क ऐप है।</string>
    <string name="faq_q2">मैं अपनी सूचनाओं का बैकअप कैसे ले सकता हूँ?</string>
    <string name="faq_a2">आप सेटिंग्स पृष्ठ से अपनी सूचनाओं को .spy फ़ाइल में निर्यात कर सकते हैं और उन्हें किसी भी समय, किसी भी डिवाइस पर पुनर्स्थापित कर सकते हैं। इसके अलावा, आप अपने डेटा का आवधिक बैकअप लेने के लिए अपने Google Drive खाते को कनेक्ट कर सकते हैं।</string>
    <string name="faq_q3">क्या Speye निःशुल्क है?</string>
    <string name="faq_a3">Speye पूरी तरह से मुफ़्त और ओपन-सोर्स है, लेकिन इसमें विज्ञापन शामिल हैं। विज्ञापनों को हमेशा के लिए हटाने के लिए आप एक बार खरीदारी कर सकते हैं। वैकल्पिक रूप से, आप F-Droid से विज्ञापन-मुक्त संस्करण प्राप्त कर सकते हैं, लेकिन उसमें Google Drive कनेक्टिविटी उपलब्ध नहीं होगी।</string>

    <string name="faq_security">सुरक्षा और गोपनीयता</string>
    <string name="faq_q4">क्या Speye मेरा डेटा संग्रहीत करता है?</string>
    <string name="faq_a4">Speye स्वयं कोई रिमोट डेटा संग्रहीत नहीं करता है और आपकी सभी सूचनाओं को आपके डिवाइस के स्थानीय स्टोरेज में सुरक्षित रखता है। Google AdMob सेवाएं विज्ञापनों के लिए डिवाइस पहचानकर्ताओं का उपयोग कर सकती हैं, जो सीधे Speye द्वारा नियंत्रित नहीं है।</string>
    <string name="faq_q5">क्लाउड सिंक कैसे काम करता है?</string>
    <string name="faq_a5">डिफ़ॉल्ट रूप से सारा डेटा आपके डिवाइस पर रहता है। यदि आप Google Drive बैकअप सक्षम करते हैं, तो एक एन्क्रिप्टेड .spy फ़ाइल आपके निजी ऐप डेटा फ़ोल्डर में संग्रहीत होती है। इसमें केवल सहेजा गया अधिसूचना डेटा (पाठ और संलग्नक) शामिल होता है।</string>
    <string name="faq_q6">क्या अन्य लोग मेरे संदेश देख सकते हैं?</string>
    <string name="faq_a6">Speye आपके व्यक्तिगत डेटा को कभी साझा नहीं करता है। हालांकि, यदि कोई आपकी .spy बैकअप फ़ाइल की प्रतिलिपि बनाता है, तो वह आपका इतिहास देखने के लिए इसे अपने फ़ोन पर आयात कर सकता है।</string>

    <string name="faq_misc">अन्य प्रश्न</string>
    <string name="faq_q7">डीबग मोड कैसे सक्षम करें?</string>
    <string name="faq_a7">सेटिंग्स पृष्ठ पर Speye लोगो पर लगातार 5 बार टैप करें।</string>
    <string name="faq_q8">बग की रिपोर्ट कैसे करें?</string>
    <string name="faq_a8">डीबग विकल्पों में लॉगिंग सक्षम करें विकल्प चालू करें, फिर अपनी इच्छित कार्रवाई करें (आयात/निर्यात, क्लाउड लॉगिन आदि)। गतिविधि लॉग में त्रुटियां दिखाई देंगी। उन्हें कॉपी करें और सेटिंग्स पृष्ठ पर संपर्क विकल्प के माध्यम से साझा करें।</string>
    <string name="faq_q9">सूचनाओं का परीक्षण कैसे करें?</string>
    <string name="faq_a9">डीबग विकल्पों में परीक्षण बटन दिखाएं सक्षम करें और इतिहास पृष्ठ पर लौटें। अब आप परीक्षण सूचनाएं भेजने के लिए बटन का उपयोग कर सकेंगे।</string>

    <!-- Privacy Policy -->
    <string name="privacy_title">गोपनीयता नीति</string>
    <string name="privacy_data_collection">डेटा संग्रह</string>
    <string name="privacy_local_storage">स्थानीय संग्रहण</string>
    <string name="privacy_local_storage_text">Speye गोपनीयता को ध्यान में रखकर बनाया गया है। टेक्स्ट, इतिहास और छवि अनुलग्नकों सहित सभी अधिसूचना डेटा आपके डिवाइस पर एक निजी डेटाबेस में स्थानीय रूप से संग्रहीत किया जाता है। हम स्वयं कोई संवेदनशील डेटा संग्रहीत या प्रसारित नहीं करते हैं।</string>
    <string name="privacy_third_party">तृतीय-पक्ष सेवाएं</string>
    <string name="privacy_third_party_text">यद्यपि Speye संवेदनशील डेटा प्रसारित नहीं करता है, ऐप का Google Play संस्करण AdMob और Google Play Services जैसी तृतीय-पक्ष सेवाओं को एकीकृत करता है। ये सेवाएं विज्ञापन वैयक्तिकरण और विश्लेषण के लिए डिवाइस पहचानकर्ता एकत्र कर सकती हैं। अधिक विवरण के लिए हम Google की गोपनीयता नीति की समीक्षा करने की अनुशंसा करते हैं।</string>
    <string name="privacy_cloud">क्लाउड बैकअप</string>
    <string name="privacy_cloud_text">यदि आप Google Drive बैकअप सक्षम करना चुनते हैं, तो Speye आपके व्यक्तिगत Google Drive खाते में एक निजी फ़ोल्डर में आपका डेटा अपलोड करता है। यह डेटा डेवलपर्स या किसी अन्य तीसरे पक्ष के लिए सुलभ नहीं है और आपके नियंत्रण में रहता है।</string>

